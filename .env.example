NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Local Docker Postgres and Vercel/Neon runtime
DATABASE_URL=postgres://shareable_docs:shareable_docs@localhost:5432/shareable_docs
DATABASE_URL_UNPOOLED=

# Agent publishing (used by the publish-doc skill, NOT by the app).
# Set these in the AGENT's environment, not in this app's .env:
# - SHAREABLE_DOCS_API_KEY is a Clerk USER-scoped API key; documents are owned
#   by the user the key belongs to.
# - SHAREABLE_DOCS_URL is the deployment base URL, without a trailing slash.
SHAREABLE_DOCS_API_KEY=
SHAREABLE_DOCS_URL=http://localhost:3000
